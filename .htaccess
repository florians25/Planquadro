# Planquadro Einsatzplanung — Wurzel-.htaccess (Webspace-Root)
#
# EMPFOHLEN bei STRATO: Stellen Sie in der STRATO-Domainverwaltung das
# Zielverzeichnis der Domain direkt auf den Ordner "public" ein.
# Dann wird diese Datei nicht benötigt und der Ordner "app" (Zugangsdaten,
# Backups) liegt automatisch außerhalb des öffentlich erreichbaren Bereichs.
#
# FALLS das Zielverzeichnis NICHT umgestellt werden kann, sorgt der folgende
# Block dafür, dass die Seite trotzdem funktioniert: alle Anfragen werden
# transparent in den Ordner "public" geleitet, und "app" bleibt gesperrt.

RewriteEngine On
Options -Indexes

# Den internen App-Ordner (Zugangsdaten + Backups) niemals ausliefern
RewriteRule ^app(/|$) - [F,L]

# Sensible Dateitypen im Wurzelverzeichnis blocken (SQL-Migrationen etc.)
<FilesMatch "\.(sql|md|epbak|gz|log|bak|old|ini|conf|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Fallback: Anfragen in den public-Ordner umleiten, sofern die Domain
# auf das Webspace-Wurzelverzeichnis statt auf /public zeigt.
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
