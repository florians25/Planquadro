# Vireo – tägliches Backup (ohne Docker)
# Installation: siehe docs/BACKUP.md, Abschnitt „Zeitsteuerung ohne Docker“
#   sudo cp deploy/systemd/vireo-*.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now vireo-backup.timer vireo-backup-check.timer
[Unit]
Description=Vireo Backup (Datenbank + Dateien, verschlüsselt)
Wants=network-online.target
After=network-online.target mariadb.service mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
# Variablen wie im Webserver: VIREO_DB_*, VIREO_BACKUP_*, VIREO_STORAGE_DIR, VIREO_ALERT_*
EnvironmentFile=/etc/vireo/vireo.env
WorkingDirectory=/var/www/vireo
ExecStart=/usr/bin/php bin/backup.php run
Nice=10
IOSchedulingClass=idle
# Härtung
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
