# Planquadro – stündliche Prüfung: Alarm (Webhook/Mail), wenn das letzte
# erfolgreiche Backup älter als PQ_BACKUP_MAX_AGE_HOURS (26 h) ist.
[Unit]
Description=Planquadro Backup-Statusprüfung

[Service]
Type=oneshot
User=www-data
Group=www-data
EnvironmentFile=/etc/planquadro/planquadro.env
WorkingDirectory=/var/www/planquadro
ExecStart=/usr/bin/php bin/backup.php status --alert
StandardOutput=null
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
