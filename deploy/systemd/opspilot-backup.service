# OpsPilot – tägliches Backup (ohne Docker)
# Installation: siehe docs/BACKUP.md, Abschnitt „Zeitsteuerung ohne Docker“
#   sudo cp deploy/systemd/opspilot-*.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now opspilot-backup.timer opspilot-backup-check.timer
[Unit]
Description=OpsPilot Backup (Datenbank + Dateien, verschlüsselt)
Wants=network-online.target
After=network-online.target mariadb.service mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
# Variablen wie im Webserver: OPSPILOT_DB_*, OPSPILOT_BACKUP_*, OPSPILOT_STORAGE_DIR, OPSPILOT_ALERT_*
EnvironmentFile=/etc/opspilot/opspilot.env
WorkingDirectory=/var/www/opspilot
ExecStart=/usr/bin/php bin/backup.php run
Nice=10
IOSchedulingClass=idle
# Härtung
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
