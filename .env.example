# OpsPilot – Konfiguration für docker-compose.yml
# ---------------------------------------------------------------------------
# Kopieren nach .env und anpassen:  cp .env.example .env && chmod 600 .env
# Passwörter und Schlüssel gehören NICHT hierher, sondern als Dateien nach
# ./secrets/ (sh docker/init-secrets.sh) – sie werden als *_FILE übergeben.
# Vollständige Referenz aller Variablen: docs/CONFIGURATION.md

# --- Image / Compose -------------------------------------------------------
# Fertiges Image (z. B. ghcr.io/<owner>/opspilot:1.2.3) oder lokal gebaut
OPSPILOT_IMAGE=opspilot/app:latest
# Basis-Image beim lokalen Bauen (bei Docker-Hub-Limits: mirror.gcr.io/library/php:8.3-apache)
#OPSPILOT_PHP_BASE=docker.io/library/php:8.3-apache
#OPSPILOT_DB_IMAGE=docker.io/library/mariadb:10.11
#OPSPILOT_CADDY_IMAGE=docker.io/library/caddy:2

# Port der App auf dem Host. 127.0.0.1 = nur lokal (für Caddy-Profil oder eigenen
# Reverse Proxy auf dem Host). 0.0.0.0 nur ohne Proxy in einem vertrauten Netz.
OPSPILOT_HTTP_BIND=127.0.0.1
OPSPILOT_HTTP_PORT=8080

# Internes Docker-Netz und feste Adresse des Caddy-Proxys (nur ändern bei Konflikten)
#OPSPILOT_SUBNET=172.31.250.0/24
#OPSPILOT_PROXY_IP=172.31.250.10

# --- HTTPS über Caddy (docker compose --profile proxy up -d) ----------------
# Hostname(s), kommagetrennt; DNS muss auf diesen Server zeigen
OPSPILOT_DOMAIN=plan.example.de
# Öffentliche Adresse (für OIDC-Redirects und Alarm-Texte)
OPSPILOT_BASE_URL=https://plan.example.de
# Session-Cookie immer "Secure" (hinter TLS-Proxy empfohlen: 1)
OPSPILOT_FORCE_SECURE_COOKIES=1
# Proxys, deren X-Forwarded-For/-Proto ausgewertet werden (Standard: Caddy-Container)
#OPSPILOT_TRUSTED_PROXIES=172.31.250.10

# --- Betrieb ----------------------------------------------------------------
# selfhosted (ein Mandant) oder saas (siehe docker-compose.saas.yml)
OPSPILOT_MODE=selfhosted
OPSPILOT_DB_NAME=opspilot
OPSPILOT_DB_USER=opspilot
OPSPILOT_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin
#OPSPILOT_DB_BUFFER_POOL=256M
# Nur für die Übernahme einer bestehenden Einsatzplanung ≤ v6.9.0 (docs/MIGRATION_PLAN.md)
#OPSPILOT_AUTO_BASELINE=v6_9_0

# --- Backup -----------------------------------------------------------------
# Öffentlicher Schlüssel kommt aus secrets/backup_public.key (OPSPILOT_BACKUP_PUBLIC_KEY_FILE).
# Der PRIVATE Schlüssel gehört nicht auf den Server (docs/BACKUP.md).
OPSPILOT_BACKUP_TIME=02:30
# Wöchentlicher Restore-Test: 1=Mo … 7=So (läuft nur mit privatem Schlüssel, siehe docs/BACKUP.md)
OPSPILOT_RESTORE_TEST_DAY=7
OPSPILOT_RESTORE_TEST_TIME=04:30
OPSPILOT_BACKUP_KEEP_DAILY=7
OPSPILOT_BACKUP_KEEP_WEEKLY=4
OPSPILOT_BACKUP_KEEP_MONTHLY=12
#OPSPILOT_BACKUP_KEEP_LAST=3
#OPSPILOT_BACKUP_KEEP_PRERESTORE_DAYS=30
#OPSPILOT_BACKUP_MAX_AGE_HOURS=26
#OPSPILOT_BACKUP_DUMPER=auto

# Externes Ziel 1: S3-kompatibel (AWS, Hetzner, Wasabi, MinIO …)
#OPSPILOT_BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
#OPSPILOT_BACKUP_S3_REGION=eu-central
#OPSPILOT_BACKUP_S3_BUCKET=opspilot-backup
#OPSPILOT_BACKUP_S3_PREFIX=opspilot
#OPSPILOT_BACKUP_S3_ACCESS_KEY=
#OPSPILOT_BACKUP_S3_SECRET_KEY=
#OPSPILOT_BACKUP_S3_PATH_STYLE=auto

# Externes Ziel 2: rclone (SFTP, WebDAV, Nextcloud, zweiter Server …)
# rclone-Konfiguration z. B. unter /data/rclone.conf ablegen und RCLONE_CONFIG setzen
#OPSPILOT_BACKUP_RCLONE_REMOTE=offsite:opspilot
#RCLONE_CONFIG=/data/rclone.conf

# Alarme bei Fehlern / Backup älter als OPSPILOT_BACKUP_MAX_AGE_HOURS
#OPSPILOT_ALERT_WEBHOOK=https://ntfy.example.de/opspilot-backup
#OPSPILOT_ALERT_EMAIL=it@example.de
#OPSPILOT_ALERT_FROM=opspilot@example.de
#OPSPILOT_ALERT_REPEAT_HOURS=24
