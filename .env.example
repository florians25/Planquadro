# Planquadro – Konfiguration für docker-compose.yml
# ---------------------------------------------------------------------------
# Kopieren nach .env und anpassen:  cp .env.example .env && chmod 600 .env
# Passwörter und Schlüssel gehören NICHT hierher, sondern als Dateien nach
# ./secrets/ (sh docker/init-secrets.sh) – sie werden als *_FILE übergeben.
# Vollständige Referenz aller Variablen: docs/CONFIGURATION.md

# --- Image / Compose -------------------------------------------------------
# Fertiges Image (z. B. ghcr.io/<owner>/planquadro:1.2.3) oder lokal gebaut
PQ_IMAGE=planquadro/app:latest
# Basis-Image beim lokalen Bauen (bei Docker-Hub-Limits: mirror.gcr.io/library/php:8.3-apache)
#PQ_PHP_BASE=docker.io/library/php:8.3-apache
#PQ_DB_IMAGE=docker.io/library/mariadb:10.11
#PQ_CADDY_IMAGE=docker.io/library/caddy:2

# Port der App auf dem Host. 127.0.0.1 = nur lokal (für Caddy-Profil oder eigenen
# Reverse Proxy auf dem Host). 0.0.0.0 nur ohne Proxy in einem vertrauten Netz.
PQ_HTTP_BIND=127.0.0.1
PQ_HTTP_PORT=8080

# Internes Docker-Netz und feste Adresse des Caddy-Proxys (nur ändern bei Konflikten)
#PQ_SUBNET=172.31.250.0/24
#PQ_PROXY_IP=172.31.250.10

# --- HTTPS über Caddy (docker compose --profile proxy up -d) ----------------
# Hostname(s), kommagetrennt; DNS muss auf diesen Server zeigen
PQ_DOMAIN=plan.example.de
# Öffentliche Adresse (für OIDC-Redirects und Alarm-Texte)
PQ_BASE_URL=https://plan.example.de
# Session-Cookie immer "Secure" (hinter TLS-Proxy empfohlen: 1)
PQ_FORCE_SECURE_COOKIES=1
# Proxys, deren X-Forwarded-For/-Proto ausgewertet werden (Standard: Caddy-Container)
#PQ_TRUSTED_PROXIES=172.31.250.10

# --- Betrieb ----------------------------------------------------------------
# selfhosted (ein Mandant) oder saas (siehe docker-compose.saas.yml)
PQ_MODE=selfhosted
PQ_DB_NAME=planquadro
PQ_DB_USER=planquadro
PQ_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin
#PQ_DB_BUFFER_POOL=256M
# Nur für die Übernahme einer bestehenden Einsatzplanung ≤ v6.9.0 (docs/MIGRATION_PLAN.md)
#PQ_AUTO_BASELINE=v6_9_0

# --- Backup -----------------------------------------------------------------
# Öffentlicher Schlüssel kommt aus secrets/backup_public.key (PQ_BACKUP_PUBLIC_KEY_FILE).
# Der PRIVATE Schlüssel gehört nicht auf den Server (docs/BACKUP.md).
PQ_BACKUP_TIME=02:30
# Wöchentlicher Restore-Test: 1=Mo … 7=So (läuft nur mit privatem Schlüssel, siehe docs/BACKUP.md)
PQ_RESTORE_TEST_DAY=7
PQ_RESTORE_TEST_TIME=04:30
PQ_BACKUP_KEEP_DAILY=7
PQ_BACKUP_KEEP_WEEKLY=4
PQ_BACKUP_KEEP_MONTHLY=12
#PQ_BACKUP_KEEP_LAST=3
#PQ_BACKUP_KEEP_PRERESTORE_DAYS=30
#PQ_BACKUP_MAX_AGE_HOURS=26
#PQ_BACKUP_DUMPER=auto

# Externes Ziel 1: S3-kompatibel (AWS, Hetzner, Wasabi, MinIO …)
#PQ_BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
#PQ_BACKUP_S3_REGION=eu-central
#PQ_BACKUP_S3_BUCKET=planquadro-backup
#PQ_BACKUP_S3_PREFIX=planquadro
#PQ_BACKUP_S3_ACCESS_KEY=
#PQ_BACKUP_S3_SECRET_KEY=
#PQ_BACKUP_S3_PATH_STYLE=auto

# Externes Ziel 2: rclone (SFTP, WebDAV, Nextcloud, zweiter Server …)
# rclone-Konfiguration z. B. unter /data/rclone.conf ablegen und RCLONE_CONFIG setzen
#PQ_BACKUP_RCLONE_REMOTE=offsite:planquadro
#RCLONE_CONFIG=/data/rclone.conf

# Alarme bei Fehlern / Backup älter als PQ_BACKUP_MAX_AGE_HOURS
#PQ_ALERT_WEBHOOK=https://ntfy.example.de/planquadro-backup
#PQ_ALERT_EMAIL=it@example.de
#PQ_ALERT_FROM=planquadro@example.de
#PQ_ALERT_REPEAT_HOURS=24
# Mail-Alarme per SMTP (das Image hat kein sendmail). STARTTLS ist Pflicht,
# außer PQ_SMTP_TLS=tls (Port 465) oder none (nur internes Relay).
#PQ_SMTP_HOST=smtp.example.de
#PQ_SMTP_PORT=587
#PQ_SMTP_TLS=starttls
#PQ_SMTP_USER=planquadro@example.de
#PQ_SMTP_PASS_FILE=/run/secrets/smtp_password
#PQ_SMTP_FROM=planquadro@example.de
# Test: docker compose exec backup php bin/backup.php alert-test

# --- Sitzungen -------------------------------------------------------------
# files (Standard) = Dateisessions; db = in der Datenbank, nötig für mehrere
# App-Container (docker-compose.replicas.yml, docs/INSTALLATION.md)
#PQ_SESSION_STORE=files
#PQ_SESSION_LIFETIME=86400
#PQ_SESSION_LOCK_TIMEOUT=10
#PQ_SESSION_POLL_LOCK_TIMEOUT=1
#PQ_APP_REPLICAS=2
