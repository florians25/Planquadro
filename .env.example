# Vireo – Konfiguration für docker-compose.yml
# ---------------------------------------------------------------------------
# Kopieren nach .env und anpassen:  cp .env.example .env && chmod 600 .env
# Passwörter und Schlüssel gehören NICHT hierher, sondern als Dateien nach
# ./secrets/ (sh docker/init-secrets.sh) – sie werden als *_FILE übergeben.
# Vollständige Referenz aller Variablen: docs/CONFIGURATION.md

# --- Image / Compose -------------------------------------------------------
# Fertiges Image (z. B. ghcr.io/<owner>/vireo:1.2.3) oder lokal gebaut
VIREO_IMAGE=vireo/app:latest
# Basis-Image beim lokalen Bauen (bei Docker-Hub-Limits: mirror.gcr.io/library/php:8.3-apache)
#VIREO_PHP_BASE=docker.io/library/php:8.3-apache
#VIREO_DB_IMAGE=docker.io/library/mariadb:10.11
#VIREO_CADDY_IMAGE=docker.io/library/caddy:2

# Port der App auf dem Host. 127.0.0.1 = nur lokal (für Caddy-Profil oder eigenen
# Reverse Proxy auf dem Host). 0.0.0.0 nur ohne Proxy in einem vertrauten Netz.
VIREO_HTTP_BIND=127.0.0.1
VIREO_HTTP_PORT=8080

# Internes Docker-Netz und feste Adresse des Caddy-Proxys (nur ändern bei Konflikten)
#VIREO_SUBNET=172.31.250.0/24
#VIREO_PROXY_IP=172.31.250.10

# --- HTTPS über Caddy (docker compose --profile proxy up -d) ----------------
# Hostname(s), kommagetrennt; DNS muss auf diesen Server zeigen
VIREO_DOMAIN=plan.example.de
# Öffentliche Adresse (für OIDC-Redirects und Alarm-Texte)
VIREO_BASE_URL=https://plan.example.de
# Session-Cookie immer "Secure" (hinter TLS-Proxy empfohlen: 1)
VIREO_FORCE_SECURE_COOKIES=1
# Proxys, deren X-Forwarded-For/-Proto ausgewertet werden (Standard: Caddy-Container)
#VIREO_TRUSTED_PROXIES=172.31.250.10

# --- Betrieb ----------------------------------------------------------------
# selfhosted (ein Mandant) oder saas (siehe docker-compose.saas.yml)
VIREO_MODE=selfhosted
VIREO_DB_NAME=vireo
VIREO_DB_USER=vireo
VIREO_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin
#VIREO_DB_BUFFER_POOL=256M
# Nur für die Übernahme einer bestehenden Einsatzplanung ≤ v6.9.0 (docs/MIGRATION_PLAN.md)
#VIREO_AUTO_BASELINE=v6_9_0

# --- Backup -----------------------------------------------------------------
# Öffentlicher Schlüssel kommt aus secrets/backup_public.key (VIREO_BACKUP_PUBLIC_KEY_FILE).
# Der PRIVATE Schlüssel gehört nicht auf den Server (docs/BACKUP.md).
VIREO_BACKUP_TIME=02:30
# Wöchentlicher Restore-Test: 1=Mo … 7=So (läuft nur mit privatem Schlüssel, siehe docs/BACKUP.md)
VIREO_RESTORE_TEST_DAY=7
VIREO_RESTORE_TEST_TIME=04:30
VIREO_BACKUP_KEEP_DAILY=7
VIREO_BACKUP_KEEP_WEEKLY=4
VIREO_BACKUP_KEEP_MONTHLY=12
#VIREO_BACKUP_KEEP_LAST=3
#VIREO_BACKUP_KEEP_PRERESTORE_DAYS=30
#VIREO_BACKUP_MAX_AGE_HOURS=26
#VIREO_BACKUP_DUMPER=auto

# Externes Ziel 1: S3-kompatibel (AWS, Hetzner, Wasabi, MinIO …)
#VIREO_BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
#VIREO_BACKUP_S3_REGION=eu-central
#VIREO_BACKUP_S3_BUCKET=vireo-backup
#VIREO_BACKUP_S3_PREFIX=vireo
#VIREO_BACKUP_S3_ACCESS_KEY=
#VIREO_BACKUP_S3_SECRET_KEY=
#VIREO_BACKUP_S3_PATH_STYLE=auto

# Externes Ziel 2: rclone (SFTP, WebDAV, Nextcloud, zweiter Server …)
# rclone-Konfiguration z. B. unter /data/rclone.conf ablegen und RCLONE_CONFIG setzen
#VIREO_BACKUP_RCLONE_REMOTE=offsite:vireo
#RCLONE_CONFIG=/data/rclone.conf

# Alarme bei Fehlern / Backup älter als VIREO_BACKUP_MAX_AGE_HOURS
#VIREO_ALERT_WEBHOOK=https://ntfy.example.de/vireo-backup
#VIREO_ALERT_EMAIL=it@example.de
#VIREO_ALERT_FROM=vireo@example.de
#VIREO_ALERT_REPEAT_HOURS=24
