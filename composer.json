{
    "name": "florians25/vireo",
    "description": "Vireo – Field & Onsite Service Management (Einsatzplanung)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": { "Vireo\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find app bin public tests -name '*.php' -print0 | xargs -0 -n1 -P4 php -l > /dev/null"
    },
    "config": { "sort-packages": true }
}
